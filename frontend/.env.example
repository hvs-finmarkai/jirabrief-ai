# Copy to .env.local for local development.
#
# Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is
# therefore public. Only put values here that are safe to expose — the Supabase
# anon key is designed for this; the service role key is NOT and must never
# appear in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend origin. In production set this to the deployed API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
