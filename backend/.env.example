# ---- Core ----
APP_ENV=development                 # set to "production" on real deployments
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# ---- Database ----
# Supabase: Settings -> Database -> connection string (async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jirabrief

# ---- Supabase auth ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---- Credential encryption (REQUIRED in production) ----
# Encrypts stored Jira API tokens and delivery-channel secrets at rest.
# MUST differ from SUPABASE_JWT_SECRET: a leaked login secret must not also
# decrypt every customer's Jira credentials.
# Generate with:  openssl rand -hex 32
# Changing it makes existing stored credentials unreadable - users have to
# reconnect their integrations.
TOKEN_ENCRYPTION_KEY=

# ---- AI ----
# Providers are tried in order: Claude -> Ollama -> deterministic fallback.
# A report is always produced; with no AI configured it is the deterministic
# one built straight from the Jira data.
AI_PROVIDER=auto                    # auto | claude | ollama
ANTHROPIC_API_KEY=                  # leave blank to skip Claude entirely
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium             # low | medium | high | xhigh | max
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Scheduler ----
# The background worker that actually runs report schedules. Safe to leave on
# across multiple instances (due schedules are claimed with row-level locks);
# set false on any replica that must not run jobs.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ---- Outbound request guard ----
# Blocks user-supplied Jira/Slack/Confluence URLs that resolve to private or
# internal addresses (SSRF protection). Set true only for local development
# against localhost - never in production.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# ---- Rate limiting ----
# Number of trusted reverse proxies in front of the app. 0 = read the peer
# address directly (correct for local dev). Behind a load balancer (Render, Fly,
# Vercel) that peer is the balancer, so every user would share one rate-limit
# bucket — set this to 1 there. Never set it above the real hop count: each
# extra hop lets a client forge one more X-Forwarded-For entry.
TRUSTED_PROXY_HOPS=0

# ---- Delivery (optional) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@jirabrief.ai

# ---- Monitoring (optional) ----
SENTRY_DSN=
